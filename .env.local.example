# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_SCHEMA=castfolio

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Castfolio Storage
SUPABASE_CASTFOLIO_MEDIA_BUCKET=castfolio-media
SUPABASE_CASTFOLIO_QR_BUCKET=castfolio-qr

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET=replace-with-random-admin-secret
CRON_SECRET=replace-with-random-cron-secret

# Resend (이메일 발송)
RESEND_API_KEY=re_your-resend-api-key

# IP Hash 보안 솔트 (임의 랜덤 문자열)
IP_HASH_SALT=your-random-salt-string

# Seed (최초 실행 시만 필요)
SEED_ADMIN_SUPABASE_UID=supabase-uid-from-auth-users
SEED_ADMIN_EMAIL=admin@yourdomain.com
